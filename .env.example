# Copy this file to .env and fill in your values.

# Supabase Postgres connection string
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"

# For local Supabase:
# DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# JWT secret for signing tokens (use a long random string in production)
JWT_SECRET="your-long-random-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# Supabase project URL and anon key
# SUPABASE_URL is auto-detected from DATABASE_URL when omitted.
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"  # needed for setup-storage

# AI - Groq API key (optional, falls back to static analysis if missing)
GROQ_API_KEY="your-groq-api-key"

# Server port (default: 5000)
PORT=5000

# Log level: trace | debug | info | warn | error (default: info)
# LOG_LEVEL=info
