{
  "name": "fittrack-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --watch src -e ts,json --exec \"node build.mjs && node --enable-source-maps ./dist/index.mjs\"",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "build": "node build.mjs",
    "typecheck": "pnpm exec tsc --noEmit",
    "setup-storage": "node ./scripts/setup-storage.mjs",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:check": "drizzle-kit check --config ./drizzle.config.ts",
    "db:check-connection": "node ./scripts/check-connection.mjs",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.0",
    "express": "^5",
    "groq-sdk": "^0.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^3.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.18.0",
    "@types/ws": "^8.5.11",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.9",
    "drizzle-zod": "^0.8.3",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "typescript": "^6.0.3"
  }
}